# Puente del lector RFID
PORT=3000

# 127.0.0.1 = solo acepta conexiones de este mismo equipo (recomendado)
HOST=127.0.0.1

# Puerto serial del lector (Windows: COM3, COM6… / Linux: /dev/ttyUSB0)
SERIAL_PORT=COM6
BAUD_RATE=9600

# true = sin lector físico; las lecturas se simulan con POST /api/simular {"uid":"..."}
SIMULAR=false

# Dirección(es) de la app web que pueden leer los códigos, separadas por coma
ORIGEN_PERMITIDO=http://localhost:5173,https://tu-app.pages.dev
