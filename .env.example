# Copia este archivo como .env y completa los valores.
# Supabase → Project Settings → API (Project URL y clave anon / publishable)
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon-o-publishable

# Nombre del producto (login, pestaña del navegador)
VITE_APP_NOMBRE=Trazabilidad

# Opcional: puente del lector RFID por puerto serial (carpeta server/)
# VITE_LECTOR_URL=http://localhost:3000

# Opcional: modo demo (ver docs/DEMO.md). Muestra la cuenta demo en el login,
# oculta "Crear cuenta" y pone un aviso de demo en la app.
# VITE_DEMO=true
# VITE_DEMO_EMAIL=demo@tudominio.cl
# VITE_DEMO_PASSWORD=demo1234
